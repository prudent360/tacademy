# --- Required in production ---------------------------------------------
# Neon/Postgres connection string. Leave unset locally to use the embedded PGlite database in .data/.
DATABASE_URL=
# At least 32 characters: openssl rand -base64 32
SESSION_SECRET=
# The first admin account. The seed resets this password on every deploy.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Public URL used in emails and payment redirects, e.g. https://academy.example.com
NEXT_PUBLIC_SITE_URL=

# --- Payments --------------------------------------------------------------
# Stripe: GBP, USD, EUR, CAD. Webhook endpoint: /api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paystack: NGN, GHS, KES, ZAR. Webhook endpoint: /api/webhooks/paystack
PAYSTACK_SECRET_KEY=

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
# A sender on a domain you've verified in Resend
EMAIL_FROM="Tekskillup Academy <hello@yourdomain.com>"

# --- Reminders -------------------------------------------------------------
# Protects /api/cron/reminders. Vercel Cron sends it automatically.
CRON_SECRET=

# --- Uploads ---------------------------------------------------------------
# Added automatically when you connect a Vercel Blob store.
# BLOB_READ_WRITE_TOKEN= or BLOB_STORE_ID=
